{#- The long benchmark report in YetiPDF markup (benchmarks/docs/report.json, made up by tools/bench-docs.php). -#}
<document font="Figtree" size="10pt" color="#14161b" lang="en" hyphenate="true" leading="0.55em" par-spacing="0.8em" title="{{ d.title }}">
  <page paper="a4" margin="56pt"/>
  <block size="22pt" weight="bold" spacing="6pt">{{ d.title }}</block>
  <block size="11pt" color="#4b5059">{{ d.subtitle }}</block>
  {%- for s in d.sections %}
  <block size="14pt" weight="semibold" above="18pt" below="8pt">{{ s.title }}</block>
  {%- for p in s.paragraphs %}
  <block align="justify">{{ p }}</block>
  {%- endfor %}
  {%- if s.table %}
  <table columns="1fr 1fr 1fr 1fr" inset="4pt 6pt" stroke-bottom="0.4pt #c9ccd3">
    <header weight="semibold"><cell>{{ s.table.head[0] }}</cell>{% for h in s.table.head|slice(1) %}<cell align="right">{{ h }}</cell>{% endfor %}</header>
    {%- for r in s.table.rows %}
    <row><cell>{{ r[0] }}</cell>{% for v in r|slice(1) %}<cell align="right">{{ v }}</cell>{% endfor %}</row>
    {%- endfor %}
  </table>
  {%- endif %}
  {%- endfor %}
</document>
