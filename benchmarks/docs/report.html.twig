{#- The long benchmark report as HTML for Dompdf, mPDF and TCPDF (benchmarks/docs/report.json). -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ d.title }}</title>
<style>
  @font-face { font-family: 'Figtree'; font-weight: 400; src: url('{{ fonts }}/Figtree-Regular.ttf'); }
  @font-face { font-family: 'Figtree'; font-weight: 600; src: url('{{ fonts }}/Figtree-SemiBold.ttf'); }
  @font-face { font-family: 'Figtree'; font-weight: 700; src: url('{{ fonts }}/Figtree-Bold.ttf'); }
  @page { size: A4; margin: 56pt; }
  body { font-family: 'Figtree', sans-serif; font-size: 10pt; color: #14161b; line-height: 1.3; margin: 0; }
  h1 { font-size: 22pt; font-weight: 700; margin: 0 0 6pt; }
  .sub { font-size: 11pt; color: #4b5059; margin: 0; }
  h2 { font-size: 14pt; font-weight: 600; margin: 18pt 0 8pt; }
  p { text-align: justify; hyphens: auto; margin: 0 0 8pt; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 8pt; }
  th, td { padding: 4pt 6pt; text-align: right; }
  th:first-child, td:first-child { text-align: left; }
  th { font-weight: 600; }
  tr:last-child td { border-bottom: 0.4pt solid #c9ccd3; }
</style>
</head>
<body>
  <h1>{{ d.title }}</h1>
  <p class="sub">{{ d.subtitle }}</p>
  {%- for s in d.sections %}
  <h2>{{ s.title }}</h2>
  {%- for p in s.paragraphs %}
  <p>{{ p }}</p>
  {%- endfor %}
  {%- if s.table %}
  <table>
    <tr>{% for h in s.table.head %}<th>{{ h }}</th>{% endfor %}</tr>
    {%- for r in s.table.rows %}
    <tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>
    {%- endfor %}
  </table>
  {%- endif %}
  {%- endfor %}
</body>
</html>
